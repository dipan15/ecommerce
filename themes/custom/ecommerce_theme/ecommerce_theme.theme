/**
 * Implements template_preprocess_form_element().
 */
function ecommerce_theme_preprocess_form_element(&$variables) {
  // Target a specific form element by its ID/Name
  if (isset($variables['element']['#name'])
   && $variables['element']['#name'] === 'user_type') {
    $variables['label']['#attributes']['class'][] = 'col-md-4';
  }
  if (isset($variables['element']['#name'])
   && $variables['element']['#name'] === 'username') {
    $variables['label']['#attributes']['class'][] = 'col-md-3';
  }
  if (isset($variables['element']['#name'])
   && $variables['element']['#name'] === 'email') {
    $variables['label']['#attributes']['class'][] = 'col-md-3';
  }
  if (isset($variables['element']['#name'])
   && $variables['element']['#name'] === 'password') {
    $variables['label']['#attributes']['class'][] = 'col-md-3';
  }
}

/**
 * Implements hook_theme_suggestions_views_view_alter() for views_view.
 */
function ecommerce_theme_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  // Get the view object
  $view = $variables['view'];
  
  // Add a suggestion targeting the specific View ID
  $suggestions[] = 'views_view__' . $view->id();
  
  // Add a suggestion targeting the specific View ID and Display ID combined
  $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_grid_responsive.
 */
function ecommerce_theme_theme_suggestions_views_view_grid_responsive_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $view_id = $view->id();
  $display_id = $view->current_display;

  // Adds: views-view-grid-responsive--view-id.html.twig
  $suggestions[] = 'views_view_grid_responsive__' . $view_id;

  // Adds: views-view-grid-responsive--view-id--display-id.html.twig
  $suggestions[] = 'views_view_grid_responsive__' . $view_id . '__' . $display_id;
}

/**
 * Implements hook_theme_suggestions_NODE_alter().
 */
function ecommerce_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  
  // Check if the node is being rendered inside a View
  if (isset($node->view)) {
    $view_id = $node->view->id();
    $display_id = $node->view->current_display;
    $bundle = $node->bundle();
    $view_mode = $variables['elements']['#view_mode'];

    // Generic view suggestion
    $suggestions[] = 'node__view__' . $view_id;

    // View + Display suggestion
    $suggestions[] = 'node__view__' . $view_id . '__' . $display_id;

    // View + Content Type suggestion
    $suggestions[] = 'node__view__' . $view_id . '__' . $bundle;

    // View + Content Type + View Mode suggestion
    $suggestions[] = 'node__view__' . $view_id . '__' . $bundle . '__' . $view_mode;
  }
}


