{# Ways to clone attributes using clone method in twig in drupal. #}

{# 1. Extract the storage data into a completely new Attribute object #}
{% set cloned_attributes = create_attribute(attributes.storage()) %}

{# 2. Directly inject a class inline without modifying the underlying variable #}
{# <div{{ attributes|add_class('temporary-class') }}>...</div> #}

{# 3. Using Sandbox/Contrib Modules #}
{# Requires the experimental Twig Clone sandbox module #}
{# {% set attributes_copy = clone(attributes) %} #}

{% set wrapper_attributes = create_attribute() %}
<div {{ wrapper_attributes.addClass('ecommerce-global') }}>
    {% if page.primary_header or page.secondary_header %}
        <div {{ attributes.addClass('ec-pg-header') }}>
            {% do attributes.removeClass('ec-pg-header') %}
            {% if page.primary_header %}
                <div {{ attributes.addClass('ec-pg-primary-header') }}>
                    {{ page.primary_header }}
                </div>
                {% do attributes.removeClass('ec-pg-primary-header') %}
            {% endif %}
            {% if page.secondary_header %}
                <div {{ attributes.addClass('ec-pg-secondary-header') }}>
                    {{ page.secondary_header }}
                </div>
                {% do attributes.removeClass('ec-pg-secondary-header') %}
            {% endif %}
        </div>
    {% endif %}
    
    {% if page.content %}
        <div {{ attributes.addClass('ec-pg-content') }}>
            {{ page.content }}
        </div>
        {% do attributes.removeClass('ec-pg-content') %}
    {% endif %}
    {% if page.footer %}
        <div {{ attributes.addClass('ec-pg-footer') }}>
            {{ page.footer }}
        </div>
        {% do attributes.removeClass('ec-pg-footer') %}
    {% endif %}
</div>
